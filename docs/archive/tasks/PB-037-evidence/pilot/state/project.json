{
  "schema_version": 2,
  "playbook_version": "0.2.0",
  "name": "ai-dev-playbook",
  "setup_status": "configured",
  "paths": {
    "docs": "docs",
    "tasks": "docs/tasks",
    "archive": "docs/archive/tasks",
    "task_index": "docs/tasks/index.md"
  },
  "documents": {
    "schema_version": 1,
    "collections": {
      "discussion": {
        "active": "docs/discussions",
        "archive": "docs/archive/discussions",
        "index": "docs/discussions/index.md"
      },
      "spec": {
        "active": "docs/specs",
        "archive": "docs/archive/specs",
        "index": "docs/specs/index.md"
      },
      "design": {
        "active": "docs/designs",
        "archive": "docs/archive/designs",
        "index": "docs/designs/index.md"
      },
      "adr": {
        "active": "docs/adr",
        "archive": "docs/archive/adr",
        "index": "docs/adr/index.md"
      },
      "plan": {
        "active": "docs/plans",
        "archive": "docs/archive/plans",
        "index": "docs/plans/index.md"
      }
    }
  },
  "components": [
    {
      "name": "playbook",
      "code": "ai-dev-playbook",
      "tests": [
        "tests"
      ],
      "migrations": null
    }
  ],
  "commands": {
    "test": "python3 -m unittest discover -s tests -v",
    "check": "python3 ai-dev-playbook/scripts/playbook.py check --ready"
  },
  "verification": {
    "inputs": [
      "AGENTS.md",
      "README.md",
      "CHANGELOG.md",
      "ai-dev-playbook",
      "docs",
      "tests"
    ],
    "checks": [
      {
        "id": "self-check",
        "argv": [
          "python3",
          "ai-dev-playbook/scripts/playbook.py",
          "check",
          "--ready"
        ],
        "timeout_seconds": 60
      },
      {
        "id": "preflight-regressions",
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_verification_smoke.py",
          "-v"
        ],
        "timeout_seconds": 120
      },
      {
        "id": "unit-tests",
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-v"
        ],
        "timeout_seconds": 1200
      }
    ]
  },
  "git": {
    "commit": "explicit_request",
    "push": "explicit_request",
    "merge": "explicit_request",
    "release": "explicit_request"
  },
  "task_workflow": {
    "schema_version": 2,
    "registry": [
      {
        "id": "self-check",
        "kind": "command",
        "purpose": "Обязательная проверка из legacy verification",
        "argv": [
          "python3",
          "ai-dev-playbook/scripts/playbook.py",
          "check",
          "--ready"
        ],
        "timeout_seconds": 60,
        "default_inputs": [
          "AGENTS.md",
          "README.md",
          "CHANGELOG.md",
          "ai-dev-playbook",
          "docs",
          "tests"
        ],
        "applicability": "always"
      },
      {
        "id": "preflight-regressions",
        "kind": "command",
        "purpose": "Обязательная проверка из legacy verification",
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_verification_smoke.py",
          "-v"
        ],
        "timeout_seconds": 120,
        "default_inputs": [
          "AGENTS.md",
          "README.md",
          "CHANGELOG.md",
          "ai-dev-playbook",
          "docs",
          "tests"
        ],
        "applicability": "always"
      },
      {
        "id": "unit-tests",
        "kind": "command",
        "purpose": "Обязательная проверка из legacy verification",
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-v"
        ],
        "timeout_seconds": 1200,
        "default_inputs": [
          "AGENTS.md",
          "README.md",
          "CHANGELOG.md",
          "ai-dev-playbook",
          "docs",
          "tests"
        ],
        "applicability": "always"
      }
    ],
    "checkpoints": {
      "merge": [
        "self-check",
        "preflight-regressions",
        "unit-tests"
      ],
      "release": [
        "self-check",
        "preflight-regressions",
        "unit-tests"
      ]
    }
  }
}
